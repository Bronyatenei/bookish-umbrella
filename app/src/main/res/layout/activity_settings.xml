<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        app:titleTextColor="@color/text_primary"
        app:navigationIconTint="@color/text_primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/localIntervalCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvLocalIntervalTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⏱ Интервал локальной проверки"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvLocalIntervalSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Используется в режимах Стабильность и Экономия"
                        android:textSize="13sp"
                        android:textColor="@color/text_hint"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvIntervalValue"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:text="5 мин"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/twitch_purple"/>

                        <SeekBar
                            android:id="@+id/seekBarInterval"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="14"
                            android:progress="4"
                            android:progressTint="@color/twitch_purple"
                            android:thumbTint="@color/twitch_purple"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 мин — 15 мин"
                        android:textSize="12sp"
                        android:textColor="@color/text_hint"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚖️ Режим мониторинга"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="8dp"/>

                    <RadioGroup
                        android:id="@+id/rgMonitoringStrategy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/rbReliable"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Стабильность — постоянное уведомление"
                            android:textColor="@color/text_primary"
                            android:checked="true"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="32dp"
                            android:layout_marginBottom="8dp"
                            android:text="Проверки выполняются в foreground-службе. Лучший вариант для своевременной тревоги."
                            android:textSize="12sp"
                            android:textColor="@color/text_hint"/>

                        <RadioButton
                            android:id="@+id/rbEconomy"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Экономия — отдельные пробуждения"
                            android:textColor="@color/text_primary"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="32dp"
                            android:text="Приложение завершается между проверками. Используется выбранный интервал, но Android может отложить фактическое пробуждение."
                            android:textSize="12sp"
                            android:textColor="@color/text_hint"/>

                        <RadioButton
                            android:id="@+id/rbHomeAgent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Домашний агент — проверки на ПК"
                            android:textColor="@color/text_primary"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="32dp"
                            android:text="Windows-компьютер проверяет Twitch и отправляет тревогу на телефон через FCM. Экономит заряд, но ПК должен быть включён и агент настроен."
                            android:textSize="12sp"
                            android:textColor="@color/text_hint"/>

                        <LinearLayout
                            android:id="@+id/homeAgentSettingsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="32dp"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Подстраховка Home Agent"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Компьютер подтверждает успешную работу раз в 5 минут. Телефон включит локальный режим, если подтверждения перестанут приходить."
                                android:textSize="12sp"
                                android:textColor="@color/text_hint"/>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Проверять состояние"
                                    android:textColor="@color/text_primary"/>

                                <TextView
                                    android:id="@+id/tvHomeAgentWatchdogValue"
                                    android:layout_width="60dp"
                                    android:layout_height="wrap_content"
                                    android:gravity="end"
                                    android:text="5 мин"
                                    android:textColor="@color/twitch_purple"
                                    android:textStyle="bold"/>
                            </LinearLayout>

                            <SeekBar
                                android:id="@+id/seekBarHomeAgentWatchdog"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:max="4"
                                android:progress="0"
                                android:progressTint="@color/twitch_purple"
                                android:thumbTint="@color/twitch_purple"/>

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:hint="Порог пропусков heartbeat (1–9)">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etMissedHeartbeats"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:maxLength="1"
                                    android:textColor="@color/text_primary"/>
                            </com.google.android.material.textfield.TextInputLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="После указанного числа пропущенных интервалов включится локальная стратегия."
                                android:textSize="12sp"
                                android:textColor="@color/text_hint"/>

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/switchHomeAgentFallbackEnabled"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Включать локальную подстраховку при потере ПК"
                                android:textColor="@color/text_primary"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Если выключить, телефон только покажет потерю связи с ПК и не начнёт локальные проверки."
                                android:textSize="12sp"
                                android:textColor="@color/text_hint"/>

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/switchHomeAgentParallelBackup"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Двойная страховка — проверять Twitch параллельно"
                                android:textColor="@color/text_primary"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="ПК проверяет часто, а телефон дополнительно проверяет Twitch с редким интервалом ниже. Повторная тревога для одного стрима блокируется."
                                android:textSize="12sp"
                                android:textColor="@color/text_hint"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="Если Home Agent недоступен"
                                android:textColor="@color/text_primary"/>

                            <Spinner
                                android:id="@+id/spinnerHomeAgentFallback"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:entries="@array/home_agent_fallback_options"/>

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/switchHomeAgentAutoReturn"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Автоматически вернуться после восстановления ПК"
                                android:textColor="@color/text_primary"/>

                            <TextView
                                android:id="@+id/tvHomeAgentStatus"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Ожидание первого heartbeat от ПК"
                                android:textSize="12sp"
                                android:textColor="@color/text_hint"/>

                            <Button
                                android:id="@+id/btnGrantHomeAgentExactAlarm"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Разрешить точный контроль"
                                android:textAllCaps="false"
                                android:visibility="gone"/>

                            <Button
                                android:id="@+id/btnReturnToHomeAgent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Вернуться к Home Agent"
                                android:textAllCaps="false"
                                android:visibility="gone"/>

                            <TextView
                                android:id="@+id/tvFcmTokenSummary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="FCM-токен: получение…"
                                android:textSize="12sp"
                                android:textColor="@color/text_hint"
                                android:maxLines="2"
                                android:ellipsize="middle"/>

                            <Button
                                android:id="@+id/btnCopyFcmToken"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Скопировать FCM-токен"
                                android:textAllCaps="false"/>
                        </LinearLayout>
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔊 Громкость будильника"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Громкость звука при срабатывании"
                        android:textSize="13sp"
                        android:textColor="@color/text_hint"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvVolumeValue"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:text="100%"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/twitch_purple"/>

                        <SeekBar
                            android:id="@+id/seekBarVolume"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="100"
                            android:progressTint="@color/twitch_purple"
                            android:thumbTint="@color/twitch_purple"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="🎵 Плейлист будильника"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:id="@+id/tvPlaylistSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Не выбран: будет использован системный звук будильника"
                        android:textSize="13sp"
                        android:textColor="@color/text_hint"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnChooseTracks"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="Выбрать треки"
                            app:backgroundTint="@color/twitch_purple"
                            app:cornerRadius="12dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClearTracks"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:text="Очистить"
                            android:textColor="@color/twitch_purple_light"
                            app:strokeColor="@color/twitch_purple_light"
                            app:cornerRadius="12dp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="🌅 Плавное нарастание громкости"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="За сколько времени звук достигнет выбранной громкости"
                        android:textSize="13sp"
                        android:textColor="@color/text_hint"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvFadeValue"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:text="30 сек"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/twitch_purple"/>

                        <SeekBar
                            android:id="@+id/seekBarFade"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="120"
                            android:progress="30"
                            android:progressTint="@color/twitch_purple"
                            android:thumbTint="@color/twitch_purple"/>
                    </LinearLayout>


                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


        </LinearLayout>
    </ScrollView>

</LinearLayout>